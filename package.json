{
  "name": "excalidraw-mac",
  "version": "2.0.0",
  "description": "Wrapper around excalidraw with local auto-save functionality",
  "license": "MIT",
  "author": "Gerald Koh",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "dmg": "electron-builder",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile": "npm run lint && npm run test && npm run format && npm run build && npm run dmg"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "electron-store": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "nanoid@^3": "^3.3.20",
    "nanoid@^4": "^5.1.16",
    "katex": "^0.19.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "build": {
    "appId": "com.geraldkoh.excalidrawmac",
    "icon": "excalidraw-app/icon.png",
    "extraResources": [
      "config.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "excalidraw-app/icon.png",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Excalidraw Drawing",
            "CFBundleTypeExtensions": [
              "excalidraw"
            ],
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.geraldkoh.excalidraw"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.geraldkoh.excalidraw",
            "UTTypeDescription": "Excalidraw Drawing",
            "UTTypeConformsTo": [
              "public.json",
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "excalidraw"
              ]
            }
          }
        ]
      }
    }
  }
}
