{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeStrategy": "squash",
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Keep package.json ranges stable and move resolved versions in package-lock.json.",
      "matchManagers": ["npm"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Automerge non-major npm updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeStrategy": "squash"
    },
    {
      "description": "Major updates stay open for review, including a major security bump.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
